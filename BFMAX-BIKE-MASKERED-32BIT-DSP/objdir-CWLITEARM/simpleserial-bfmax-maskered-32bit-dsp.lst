 443:.././hal//stm32f3/CMSIS/core/cmsis_gcc.h **** 
 444:.././hal//stm32f3/CMSIS/core/cmsis_gcc.h **** /**
 445:.././hal//stm32f3/CMSIS/core/cmsis_gcc.h ****   \brief   Reverse byte order (32 bit)
