 557:.././hal//stm32f3/CMSIS/core/cmsis_gcc.h **** #if       (__CORTEX_M >= 0x03U) || (__CORTEX_SC >= 300U)
 558:.././hal//stm32f3/CMSIS/core/cmsis_gcc.h **** 
 559:.././hal//stm32f3/CMSIS/core/cmsis_gcc.h **** /**
 560:.././hal//stm32f3/CMSIS/core/cmsis_gcc.h ****   \brief   LDR Exclusive (8 bit)
 561:.././hal//stm32f3/CMSIS/core/cmsis_gcc.h ****   \details Executes a exclusive LDR instruction for 8 bit value.
 562:.././hal//stm32f3/CMSIS/core/cmsis_gcc.h ****   \param [in]    ptr  Pointer to data
 563:.././hal//stm32f3/CMSIS/core/cmsis_gcc.h ****   \return             value of type uint8_t at (*ptr)
 564:.././hal//stm32f3/CMSIS/core/cmsis_gcc.h ****  */
 565:.././hal//stm32f3/CMSIS/core/cmsis_gcc.h **** __attribute__((always_inline)) __STATIC_INLINE uint8_t __LDREXB(volatile uint8_t *addr)
 566:.././hal//stm32f3/CMSIS/core/cmsis_gcc.h **** {
 567:.././hal//stm32f3/CMSIS/core/cmsis_gcc.h ****     uint32_t result;
 568:.././hal//stm32f3/CMSIS/core/cmsis_gcc.h **** 
 569:.././hal//stm32f3/CMSIS/core/cmsis_gcc.h **** #if (__GNUC__ > 4) || (__GNUC__ == 4 && __GNUC_MINOR__ >= 8)
 570:.././hal//stm32f3/CMSIS/core/cmsis_gcc.h ****    __ASM volatile ("ldrexb %0, %1" : "=r" (result) : "Q" (*addr) );
 571:.././hal//stm32f3/CMSIS/core/cmsis_gcc.h **** #else
