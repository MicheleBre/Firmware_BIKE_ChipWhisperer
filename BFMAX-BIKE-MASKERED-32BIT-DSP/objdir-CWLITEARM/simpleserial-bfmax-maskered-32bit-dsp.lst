 136:simpleserial-bfmax-maskered-32bit-dsp.c **** /* =========================================================================
 137:simpleserial-bfmax-maskered-32bit-dsp.c ****  * update_sparse_vulnerable: INVARIATA (fuori scope di questa richiesta,
 138:simpleserial-bfmax-maskered-32bit-dsp.c ****  * vedi nota sopra: contiene ancora il leak di potenza indirizzo-dipendente)
 139:simpleserial-bfmax-maskered-32bit-dsp.c ****  * ======================================================================== */
 140:simpleserial-bfmax-maskered-32bit-dsp.c **** 
 141:simpleserial-bfmax-maskered-32bit-dsp.c **** void __attribute__((noinline)) update_sparse_vulnerable(uint16_t col) {
 142:simpleserial-bfmax-maskered-32bit-dsp.c ****     uint8_t block = (col >= R_BITS) ? 1 : 0;
 143:simpleserial-bfmax-maskered-32bit-dsp.c ****     uint16_t col_bit = (block == 1) ? (col - R_BITS) : col;
 144:simpleserial-bfmax-maskered-32bit-dsp.c **** 
 145:simpleserial-bfmax-maskered-32bit-dsp.c ****     for (uint8_t k = 0; k < D_WEIGHT; k++) {
 146:simpleserial-bfmax-maskered-32bit-dsp.c ****         uint16_t row = Htr_sparse[block][k] + col_bit;
 147:simpleserial-bfmax-maskered-32bit-dsp.c ****         if (row >= R_BITS) {
 148:simpleserial-bfmax-maskered-32bit-dsp.c ****             row -= R_BITS;
 149:simpleserial-bfmax-maskered-32bit-dsp.c ****         }
 150:simpleserial-bfmax-maskered-32bit-dsp.c **** 
 151:simpleserial-bfmax-maskered-32bit-dsp.c ****         syndrome_bits[row] ^= 1;
 152:simpleserial-bfmax-maskered-32bit-dsp.c ****         int8_t delta = syndrome_bits[row] ? +1 : -1;
 153:simpleserial-bfmax-maskered-32bit-dsp.c ****         upc[row] = (uint8_t)(upc[row] + delta);
 154:simpleserial-bfmax-maskered-32bit-dsp.c ****     }
 155:simpleserial-bfmax-maskered-32bit-dsp.c **** }
