   8:simpleserial-bfmax-maskered-32bit-dsp.c **** /* =========================================================================
   9:simpleserial-bfmax-maskered-32bit-dsp.c ****  * PARAMETRI CRITTOGRAFICI SCALATI PER SRAM MICROCONTROLLORE (CW-Lite/STM32)
  10:simpleserial-bfmax-maskered-32bit-dsp.c ****  * ========================================================================= */
  11:simpleserial-bfmax-maskered-32bit-dsp.c **** #define N0 2
  12:simpleserial-bfmax-maskered-32bit-dsp.c **** #define R_BITS 512
  13:simpleserial-bfmax-maskered-32bit-dsp.c **** #define N_BITS (N0 * R_BITS)
  14:simpleserial-bfmax-maskered-32bit-dsp.c **** #define D_WEIGHT 15          /* Peso della riga sparsa segreta (supp(h)) */
  15:simpleserial-bfmax-maskered-32bit-dsp.c **** #define ITER_MAX_BFMAX 20    /* Numero massimo di iterazioni del decoder */
  16:simpleserial-bfmax-maskered-32bit-dsp.c **** 
  17:simpleserial-bfmax-maskered-32bit-dsp.c **** 
  18:simpleserial-bfmax-maskered-32bit-dsp.c **** __attribute__((aligned(4))) static uint8_t upc[N_BITS];
  19:simpleserial-bfmax-maskered-32bit-dsp.c **** static uint8_t syndrome_bits[R_BITS];
  20:simpleserial-bfmax-maskered-32bit-dsp.c **** static uint16_t Htr_sparse[N0][D_WEIGHT];
  21:simpleserial-bfmax-maskered-32bit-dsp.c **** 
  22:simpleserial-bfmax-maskered-32bit-dsp.c **** /* =========================================================================
  23:simpleserial-bfmax-maskered-32bit-dsp.c ****  * PRIMITIVE A TEMPO COSTANTE
  24:simpleserial-bfmax-maskered-32bit-dsp.c ****  * Nessuna di queste contiene un "if" che dipenda da un valore segreto o
  25:simpleserial-bfmax-maskered-32bit-dsp.c ****  * dal contenuto dell'array: ogni selezione avviene tramite maschere
  26:simpleserial-bfmax-maskered-32bit-dsp.c ****  * bit a bit (AND/OR/NOT), usando le stesse intrinsics DSP già presenti
  27:simpleserial-bfmax-maskered-32bit-dsp.c ****  * nel firmware originale (__USUB8/__SEL), che sul Cortex-M4 realizzano
  28:simpleserial-bfmax-maskered-32bit-dsp.c ****  * esattamente un "select" predicato a livello hardware, un ciclo per word.
  29:simpleserial-bfmax-maskered-32bit-dsp.c ****  * ========================================================================= */
  30:simpleserial-bfmax-maskered-32bit-dsp.c **** 
  31:simpleserial-bfmax-maskered-32bit-dsp.c **** 
  32:simpleserial-bfmax-maskered-32bit-dsp.c **** /* =========================================================================
  33:simpleserial-bfmax-maskered-32bit-dsp.c ****  * argmax_u8_constant_time: CONTROMISURA al timing leak.
  34:simpleserial-bfmax-maskered-32bit-dsp.c ****  *
  35:simpleserial-bfmax-maskered-32bit-dsp.c ****  * Differenze rispetto a argmax_u8_vulnerable:
  36:simpleserial-bfmax-maskered-32bit-dsp.c ****  *  1) Il Passo 2 scorre SEMPRE l'intero array, parola per parola, senza
  37:simpleserial-bfmax-maskered-32bit-dsp.c ****  *     alcun early-exit: trigger_high()/trigger_low() racchiudono l'intera
  38:simpleserial-bfmax-maskered-32bit-dsp.c ****  *     scansione, quindi il tempo misurato NON dipende più dalla posizione
  39:simpleserial-bfmax-maskered-32bit-dsp.c ****  *     del massimo.
  40:simpleserial-bfmax-maskered-32bit-dsp.c ****  *  2) L'indice del match (sia a livello di word che di byte dentro la word)
  41:simpleserial-bfmax-maskered-32bit-dsp.c ****  *     viene selezionato tramite maschere bit a bit, non tramite `if`/`return`
  42:simpleserial-bfmax-maskered-32bit-dsp.c ****  *     condizionati dal confronto col segreto. Il "primo match" viene
  43:simpleserial-bfmax-maskered-32bit-dsp.c ****  *     preservato tramite una maschera "found" sticky (OR cumulativo),
  44:simpleserial-bfmax-maskered-32bit-dsp.c ****  *     esattamente come semanticamente faceva la catena di if originale,
  45:simpleserial-bfmax-maskered-32bit-dsp.c ****  *     ma senza salti condizionali sul dato segreto.
  46:simpleserial-bfmax-maskered-32bit-dsp.c ****  *  3) Anche l'estrazione dello scalare massimo dal vettore a 4 byte (che
  47:simpleserial-bfmax-maskered-32bit-dsp.c ****  *     nell'originale usava 3 `if`) ora usa ct_max_u8: la differenza è
  48:simpleserial-bfmax-maskered-32bit-dsp.c ****  *     minore ai fini del leak (dipende dal VALORE massimo, non dalla sua
  49:simpleserial-bfmax-maskered-32bit-dsp.c ****  *     POSIZIONE), ma viene comunque resa mascherata per coerenza, dato
  50:simpleserial-bfmax-maskered-32bit-dsp.c ****  *     che la richiesta è eliminare ogni salto condizionale.
  51:simpleserial-bfmax-maskered-32bit-dsp.c ****  *
  52:simpleserial-bfmax-maskered-32bit-dsp.c ****  * NOTA DI SCOPE: questa contromisura chiude SOLO il leak temporale di
  53:simpleserial-bfmax-maskered-32bit-dsp.c ****  * argmax. Il leak di POTENZA indirizzo-dipendente in
  54:simpleserial-bfmax-maskered-32bit-dsp.c ****  * update_sparse_vulnerable (l'accesso a upc[row] con row che dipende da
  55:simpleserial-bfmax-maskered-32bit-dsp.c ****  * Htr_sparse) resta un problema separato e non viene toccato qui: una
  56:simpleserial-bfmax-maskered-32bit-dsp.c ****  * contromisura per quello richiederebbe un accesso "oblivious" che tocchi
  57:simpleserial-bfmax-maskered-32bit-dsp.c ****  * ogni posizione di upc ad ogni aggiornamento (costoso, O(R_BITS) invece di
  58:simpleserial-bfmax-maskered-32bit-dsp.c ****  * O(D_WEIGHT)), e andrebbe discussa a parte se interessa.
  59:simpleserial-bfmax-maskered-32bit-dsp.c ****  * ========================================================================= */
  60:simpleserial-bfmax-maskered-32bit-dsp.c **** uint16_t __attribute__((noinline)) argmax_u8_constant_time(const uint8_t *arr, uint16_t len) {
  61:simpleserial-bfmax-maskered-32bit-dsp.c ****     uint32_t max_vec = 0;
  62:simpleserial-bfmax-maskered-32bit-dsp.c ****     const uint32_t *arr32 = (const uint32_t *)arr;
  63:simpleserial-bfmax-maskered-32bit-dsp.c ****     uint16_t len32 = len / 4;
  64:simpleserial-bfmax-maskered-32bit-dsp.c **** 
  65:simpleserial-bfmax-maskered-32bit-dsp.c ****     /* ---------------------------------------------------------------------
  66:simpleserial-bfmax-maskered-32bit-dsp.c ****      * PASSO 1: Ricerca del massimo assoluto vettoriale
  67:simpleserial-bfmax-maskered-32bit-dsp.c ****      * --------------------------------------------------------------------- */
  68:simpleserial-bfmax-maskered-32bit-dsp.c ****     for (uint16_t i = 0; i < len32; i++) {
  69:simpleserial-bfmax-maskered-32bit-dsp.c ****         uint32_t val = arr32[i];
  70:simpleserial-bfmax-maskered-32bit-dsp.c ****         __USUB8(val, max_vec);
  71:simpleserial-bfmax-maskered-32bit-dsp.c ****         max_vec = __SEL(val, max_vec);
  72:simpleserial-bfmax-maskered-32bit-dsp.c ****     }
  73:simpleserial-bfmax-maskered-32bit-dsp.c **** 
  74:simpleserial-bfmax-maskered-32bit-dsp.c ****     /* Riduzione orizzontale a 32-bit SIMD (da 4 lane a 1 scalare) */
  75:simpleserial-bfmax-maskered-32bit-dsp.c ****     /* Confronta la metà alta con la metà bassa */
  76:simpleserial-bfmax-maskered-32bit-dsp.c ****     uint32_t hi_shifted = max_vec >> 16;
  77:simpleserial-bfmax-maskered-32bit-dsp.c ****     __USUB8(max_vec, hi_shifted);
  78:simpleserial-bfmax-maskered-32bit-dsp.c ****     uint32_t m2 = __SEL(max_vec, hi_shifted);
  79:simpleserial-bfmax-maskered-32bit-dsp.c **** 
  80:simpleserial-bfmax-maskered-32bit-dsp.c ****     /* Confronta il secondo byte con il primo byte */
  81:simpleserial-bfmax-maskered-32bit-dsp.c ****     uint32_t byte_shifted = m2 >> 8;
  82:simpleserial-bfmax-maskered-32bit-dsp.c ****     __USUB8(m2, byte_shifted);
  83:simpleserial-bfmax-maskered-32bit-dsp.c ****     uint32_t final_max = __SEL(m2, byte_shifted);
  84:simpleserial-bfmax-maskered-32bit-dsp.c **** 
  85:simpleserial-bfmax-maskered-32bit-dsp.c ****     uint8_t max_val = (uint8_t)(final_max & 0xFF);
  86:simpleserial-bfmax-maskered-32bit-dsp.c **** 
  87:simpleserial-bfmax-maskered-32bit-dsp.c **** 
  88:simpleserial-bfmax-maskered-32bit-dsp.c ****     /* ---------------------------------------------------------------------
  89:simpleserial-bfmax-maskered-32bit-dsp.c ****      * PASSO 2: Ricerca dell'indice a tempo costante (Puro 32-bit SIMD)
  90:simpleserial-bfmax-maskered-32bit-dsp.c ****      * --------------------------------------------------------------------- */
  91:simpleserial-bfmax-maskered-32bit-dsp.c ****     uint32_t target_vec = (uint32_t)max_val * 0x01010101u;
  92:simpleserial-bfmax-maskered-32bit-dsp.c **** 
  93:simpleserial-bfmax-maskered-32bit-dsp.c ****     uint32_t result_index = 0;
  94:simpleserial-bfmax-maskered-32bit-dsp.c ****     uint32_t found_global = 0x00000000; /* 0xFFFFFFFF sticky al primo match */
  95:simpleserial-bfmax-maskered-32bit-dsp.c **** 
  96:simpleserial-bfmax-maskered-32bit-dsp.c ****     trigger_high();
  97:simpleserial-bfmax-maskered-32bit-dsp.c ****     for (uint16_t i = 0; i < len32; i++) {
  98:simpleserial-bfmax-maskered-32bit-dsp.c ****         uint32_t val = arr32[i];
  99:simpleserial-bfmax-maskered-32bit-dsp.c **** 
 100:simpleserial-bfmax-maskered-32bit-dsp.c ****         /* Confronto SIMD 4-lane: target_vec è il massimo assoluto,
 101:simpleserial-bfmax-maskered-32bit-dsp.c ****          * quindi val >= target_vec equivale a val == target_vec.
 102:simpleserial-bfmax-maskered-32bit-dsp.c ****          * match conterrà 0xFF nelle lane coincidenti, 0x00 nelle altre. */
 103:simpleserial-bfmax-maskered-32bit-dsp.c ****         __USUB8(val, target_vec);
 104:simpleserial-bfmax-maskered-32bit-dsp.c ****         uint32_t match = __SEL(0xFFFFFFFF, 0x00000000);
 105:simpleserial-bfmax-maskered-32bit-dsp.c **** 
 106:simpleserial-bfmax-maskered-32bit-dsp.c ****         /* Calcolo della maschera di presenza nella word (branchless a 32 bit):
 107:simpleserial-bfmax-maskered-32bit-dsp.c ****          * Se match != 0 produce 0xFFFFFFFF, se match == 0 produce 0x00000000 */
 108:simpleserial-bfmax-maskered-32bit-dsp.c ****         uint32_t has_match = (uint32_t)(((int32_t)match | -(int32_t)match) >> 31);
 109:simpleserial-bfmax-maskered-32bit-dsp.c **** 
 110:simpleserial-bfmax-maskered-32bit-dsp.c ****         /* Determinazione dell'offset del primo byte (Little-Endian) in 2 istruzioni:
 111:simpleserial-bfmax-maskered-32bit-dsp.c ****          * 1) __RBIT inverte i 32 bit: il bit 7 (MSB del byte 0) diventa il bit 31.
 112:simpleserial-bfmax-maskered-32bit-dsp.c ****          *    Se il byte 0 ha fatto match, il bit 31 varrà 1 -> __CLZ darà 0.
 113:simpleserial-bfmax-maskered-32bit-dsp.c ****          *    Se il match è sul byte 1, il primo '1' sarà al bit 23 -> __CLZ darà 8.
 114:simpleserial-bfmax-maskered-32bit-dsp.c ****          * 2) Dividendo per 8 (shift >> 3), otteniamo esattamente l'offset (0, 1, 2 o 3).
 115:simpleserial-bfmax-maskered-32bit-dsp.c ****          * Nessun loop, nessun branch, costo deterministico di 2 cicli di clock. */
 116:simpleserial-bfmax-maskered-32bit-dsp.c ****         uint32_t offset = __CLZ(__RBIT(match)) >> 3;
 117:simpleserial-bfmax-maskered-32bit-dsp.c **** 
 118:simpleserial-bfmax-maskered-32bit-dsp.c ****         /* Maschera di selezione globale: attiva solo se abbiamo un match in questa
 119:simpleserial-bfmax-maskered-32bit-dsp.c ****          * word E nessun match è stato registrato in precedenza */
 120:simpleserial-bfmax-maskered-32bit-dsp.c ****         uint32_t sel_global = has_match & ~found_global;
 121:simpleserial-bfmax-maskered-32bit-dsp.c **** 
 122:simpleserial-bfmax-maskered-32bit-dsp.c ****         /* Indice candidato: i * 4 + offset */
 123:simpleserial-bfmax-maskered-32bit-dsp.c ****         uint32_t candidate = ((uint32_t)i << 2) | offset;
 124:simpleserial-bfmax-maskered-32bit-dsp.c **** 
 125:simpleserial-bfmax-maskered-32bit-dsp.c ****         /* Aggiornamento branchless a 32 bit dell'indice */
 126:simpleserial-bfmax-maskered-32bit-dsp.c ****         result_index = (candidate & sel_global) | (result_index & ~sel_global);
 127:simpleserial-bfmax-maskered-32bit-dsp.c **** 
 128:simpleserial-bfmax-maskered-32bit-dsp.c ****         /* Aggiornamento dello stato sticky */
 129:simpleserial-bfmax-maskered-32bit-dsp.c ****         found_global |= has_match;
 130:simpleserial-bfmax-maskered-32bit-dsp.c ****     }
 131:simpleserial-bfmax-maskered-32bit-dsp.c ****     trigger_low();
 132:simpleserial-bfmax-maskered-32bit-dsp.c **** 
 133:simpleserial-bfmax-maskered-32bit-dsp.c ****     return (uint16_t)result_index;
 134:simpleserial-bfmax-maskered-32bit-dsp.c **** }
