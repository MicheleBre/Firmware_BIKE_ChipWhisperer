  24:simpleserial-bfmax-32bit-dsp.c **** /* =========================================================================
  25:simpleserial-bfmax-32bit-dsp.c ****  * FUNZIONE VULNERABILE 1: argmax_u8_vulnerable (Puro SIMD ARM Cortex-M4)
  26:simpleserial-bfmax-32bit-dsp.c ****  * Contiene l'early-exit nel secondo ciclo che genera il Timing Leak lineare.
  27:simpleserial-bfmax-32bit-dsp.c ****  * Sfrutta le istruzioni DSP __USUB8 e __SEL in un singolo ciclo per blocco.
  28:simpleserial-bfmax-32bit-dsp.c ****  * ========================================================================= */
  29:simpleserial-bfmax-32bit-dsp.c **** POS_T __attribute__((noinline)) argmax_u8_vulnerable(const uint8_t *arr, uint16_t len) {
  30:simpleserial-bfmax-32bit-dsp.c ****     uint32_t max_vec = 0;
  31:simpleserial-bfmax-32bit-dsp.c ****     const uint32_t *arr32 = (const uint32_t *)arr;
  32:simpleserial-bfmax-32bit-dsp.c ****     uint16_t len32 = len / 4; 
  33:simpleserial-bfmax-32bit-dsp.c ****     
  34:simpleserial-bfmax-32bit-dsp.c ****     /* ---------------------------------------------------------------------
  35:simpleserial-bfmax-32bit-dsp.c ****      * PASSO 1: Ricerca del massimo assoluto (tempo costante)
  36:simpleserial-bfmax-32bit-dsp.c ****      * --------------------------------------------------------------------- */
  37:simpleserial-bfmax-32bit-dsp.c ****     for (uint16_t i = 0; i < len32; i++) {
  38:simpleserial-bfmax-32bit-dsp.c ****         uint32_t val = arr32[i];
  39:simpleserial-bfmax-32bit-dsp.c ****         
  40:simpleserial-bfmax-32bit-dsp.c ****         /* 1 Ciclo: Sottrae e imposta i flag GE per i 4 byte */
  41:simpleserial-bfmax-32bit-dsp.c ****         __USUB8(val, max_vec);
  42:simpleserial-bfmax-32bit-dsp.c ****         
  43:simpleserial-bfmax-32bit-dsp.c ****         /* 1 Ciclo: Seleziona byte da 'val' se GE=1, altrimenti da 'max_vec' */
  44:simpleserial-bfmax-32bit-dsp.c ****         max_vec = __SEL(val, max_vec);
  45:simpleserial-bfmax-32bit-dsp.c ****     }
  46:simpleserial-bfmax-32bit-dsp.c **** 
  47:simpleserial-bfmax-32bit-dsp.c ****     /* Estrazione scalare del massimo dal vettore 4-in-1 */
  48:simpleserial-bfmax-32bit-dsp.c ****     uint8_t *max_bytes = (uint8_t *)&max_vec;
  49:simpleserial-bfmax-32bit-dsp.c ****     uint8_t max_val = max_bytes[0];
  50:simpleserial-bfmax-32bit-dsp.c ****     if (max_bytes[1] > max_val) max_val = max_bytes[1];
  51:simpleserial-bfmax-32bit-dsp.c ****     if (max_bytes[2] > max_val) max_val = max_bytes[2];
  52:simpleserial-bfmax-32bit-dsp.c ****     if (max_bytes[3] > max_val) max_val = max_bytes[3];
  53:simpleserial-bfmax-32bit-dsp.c **** 
  54:simpleserial-bfmax-32bit-dsp.c ****    
  55:simpleserial-bfmax-32bit-dsp.c ****     /* ---------------------------------------------------------------------
  56:simpleserial-bfmax-32bit-dsp.c ****      * PASSO 2: Ricerca dell'indice vettorizzata (TIMING LEAK PRESERVATO)
  57:simpleserial-bfmax-32bit-dsp.c ****      * --------------------------------------------------------------------- */
  58:simpleserial-bfmax-32bit-dsp.c ****     uint32_t target_vec = (max_val << 24) | (max_val << 16) | (max_val << 8) | max_val;
  59:simpleserial-bfmax-32bit-dsp.c **** 
  60:simpleserial-bfmax-32bit-dsp.c ****     trigger_high();
  61:simpleserial-bfmax-32bit-dsp.c ****     for (uint16_t i = 0; i < len32; i++) {
  62:simpleserial-bfmax-32bit-dsp.c ****         uint32_t val = arr32[i];
  63:simpleserial-bfmax-32bit-dsp.c ****         
  64:simpleserial-bfmax-32bit-dsp.c ****         /* CONFRONTO IN 1 CICLO DI CLOCK: 
  65:simpleserial-bfmax-32bit-dsp.c ****          * L'istruzione __USUB8 (Unsigned Subtract 8-bit) calcola val - target_vec.
  66:simpleserial-bfmax-32bit-dsp.c ****          * Poiché target_vec è il massimo, val non sarà mai > target_vec.
  67:simpleserial-bfmax-32bit-dsp.c ****          * Il flag GE andrà a 1 SE E SOLO SE val == target_vec. */
  68:simpleserial-bfmax-32bit-dsp.c ****         __USUB8(val, target_vec);
  69:simpleserial-bfmax-32bit-dsp.c ****         
  70:simpleserial-bfmax-32bit-dsp.c ****         /* 1 CICLO DI CLOCK PER MATERIALIZZARE I FLAG:
  71:simpleserial-bfmax-32bit-dsp.c ****          * Seleziona 0xFF per ogni byte dove GE=1 (match) e 0x00 dove GE=0. */
  72:simpleserial-bfmax-32bit-dsp.c ****         uint32_t match = __SEL(0xFFFFFFFF, 0x00000000);
  73:simpleserial-bfmax-32bit-dsp.c ****         
  74:simpleserial-bfmax-32bit-dsp.c ****         if (match != 0) {
  75:simpleserial-bfmax-32bit-dsp.c ****             trigger_low();
  76:simpleserial-bfmax-32bit-dsp.c ****             /* Trovato il blocco! Identificazione dell'indice esatto.
  77:simpleserial-bfmax-32bit-dsp.c ****              * EARLY EXIT: L'uscita prematura crea un timing leak lineare. */
  78:simpleserial-bfmax-32bit-dsp.c ****             uint8_t *match_bytes = (uint8_t *)&match;
  79:simpleserial-bfmax-32bit-dsp.c ****             if (match_bytes[0]){
  80:simpleserial-bfmax-32bit-dsp.c ****                 //trigger_low();
  81:simpleserial-bfmax-32bit-dsp.c ****                 return (POS_T)(i * 4 + 0);
  82:simpleserial-bfmax-32bit-dsp.c ****             }
  83:simpleserial-bfmax-32bit-dsp.c ****             if (match_bytes[1])
  84:simpleserial-bfmax-32bit-dsp.c ****             {
  85:simpleserial-bfmax-32bit-dsp.c ****                 //trigger_low();
  86:simpleserial-bfmax-32bit-dsp.c ****                 return (POS_T)(i * 4 + 1);
  87:simpleserial-bfmax-32bit-dsp.c ****             }
  88:simpleserial-bfmax-32bit-dsp.c ****             if (match_bytes[2]) {
  89:simpleserial-bfmax-32bit-dsp.c ****                 //trigger_low();
  90:simpleserial-bfmax-32bit-dsp.c ****                 return (POS_T)(i * 4 + 2);
  91:simpleserial-bfmax-32bit-dsp.c ****             }
  92:simpleserial-bfmax-32bit-dsp.c ****             
  93:simpleserial-bfmax-32bit-dsp.c ****             //trigger_low();
  94:simpleserial-bfmax-32bit-dsp.c ****             return (POS_T)(i * 4 + 3);
  95:simpleserial-bfmax-32bit-dsp.c ****         }
  96:simpleserial-bfmax-32bit-dsp.c ****     }
  97:simpleserial-bfmax-32bit-dsp.c **** 
  98:simpleserial-bfmax-32bit-dsp.c ****     return 0;
  99:simpleserial-bfmax-32bit-dsp.c **** }
