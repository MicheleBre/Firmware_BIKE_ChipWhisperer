  26:simpleserial-bfmax-maskered-8bit.c **** /* =========================================================================
  27:simpleserial-bfmax-maskered-8bit.c ****  * FUNZIONE 1 OTTIMIZZATA: argmax_u8
  28:simpleserial-bfmax-maskered-8bit.c ****  * ========================================================================= */
  29:simpleserial-bfmax-maskered-8bit.c **** POS_T __attribute__((noinline)) argmax_u8_vulnerable(const uint8_t *arr, uint16_t len) {
  30:simpleserial-bfmax-maskered-8bit.c ****     uint8_t max_val = 0;
  31:simpleserial-bfmax-maskered-8bit.c **** 
  32:simpleserial-bfmax-maskered-8bit.c ****     /* Passo 1: Ricerca del valore massimo assoluto (tempo costante su tutta la lunghezza) */
  33:simpleserial-bfmax-maskered-8bit.c ****     for (uint16_t i = 0; i < len; i++) {
  34:simpleserial-bfmax-maskered-8bit.c ****         /* Maschera: tutti 1(0xFF) se arr[i] > max_val, altrimenti tutti 0 (0x00) */
  35:simpleserial-bfmax-maskered-8bit.c ****         uint8_t is_greater = (uint8_t)((max_val - arr[i]) >> 7); 
  36:simpleserial-bfmax-maskered-8bit.c ****         uint8_t mask = (uint8_t)(-(int8_t)is_greater);
  37:simpleserial-bfmax-maskered-8bit.c ****         
  38:simpleserial-bfmax-maskered-8bit.c ****         max_val = (max_val & ~mask) | (arr[i] & mask);
  39:simpleserial-bfmax-maskered-8bit.c ****     }
  40:simpleserial-bfmax-maskered-8bit.c **** 
  41:simpleserial-bfmax-maskered-8bit.c ****     //Variabile di salvataggio del massimo
  42:simpleserial-bfmax-maskered-8bit.c ****     POS_T max_col = 0;
  43:simpleserial-bfmax-maskered-8bit.c ****     POS_T found_flag = 0; // Flag per indicare se il massimo è stato trovato, serve per ignorare t
  44:simpleserial-bfmax-maskered-8bit.c **** 
  45:simpleserial-bfmax-maskered-8bit.c ****     /* Passo 2: Ricerca della prima posizione 'col' corrispondente a max_val.
  46:simpleserial-bfmax-maskered-8bit.c ****     Optimized: salvataggio massimo e maschera per il branchless */
  47:simpleserial-bfmax-maskered-8bit.c ****     for (uint16_t i = 0; i < len; i++) {
  48:simpleserial-bfmax-maskered-8bit.c ****         /* Calcola la differenza */
  49:simpleserial-bfmax-maskered-8bit.c ****         uint8_t diff = arr[i] ^ max_val;
  50:simpleserial-bfmax-maskered-8bit.c **** 
  51:simpleserial-bfmax-maskered-8bit.c ****         /* is_equal = 1 se arr[i] == max_val, altrimenti 0 */
  52:simpleserial-bfmax-maskered-8bit.c ****         uint16_t is_not_equal = ((uint16_t)(diff | (uint8_t)(-diff)) >> 7) & 1;
  53:simpleserial-bfmax-maskered-8bit.c ****         uint16_t is_equal = 1 - is_not_equal;
  54:simpleserial-bfmax-maskered-8bit.c **** 
  55:simpleserial-bfmax-maskered-8bit.c ****         /* Condizione attiva SOLO se è uguale E non è ancora stato trovato (found_flag == 0) */
  56:simpleserial-bfmax-maskered-8bit.c ****         uint16_t take_this = is_equal & (1 - found_flag);
  57:simpleserial-bfmax-maskered-8bit.c **** 
  58:simpleserial-bfmax-maskered-8bit.c ****         /* Espande take_this in maschera a 16 bit:
  59:simpleserial-bfmax-maskered-8bit.c ****          * take_this == 1 -> 0xFFFF
  60:simpleserial-bfmax-maskered-8bit.c ****          * take_this == 0 -> 0x0000 */
  61:simpleserial-bfmax-maskered-8bit.c ****         uint16_t mask = (uint16_t)(-(int16_t)take_this);
  62:simpleserial-bfmax-maskered-8bit.c **** 
  63:simpleserial-bfmax-maskered-8bit.c ****         /* Selezione multiplexer bitwise:
  64:simpleserial-bfmax-maskered-8bit.c ****          * se mask == 0xFFFF -> col_found assume 'i'
  65:simpleserial-bfmax-maskered-8bit.c ****          * se mask == 0x0000 -> col_found resta invariato */
  66:simpleserial-bfmax-maskered-8bit.c ****         max_col = (max_col & ~mask) | (i & mask);
  67:simpleserial-bfmax-maskered-8bit.c **** 
  68:simpleserial-bfmax-maskered-8bit.c ****         /* Aggiorna il flag: una volta a 1, resta 1 fino alla fine del ciclo */
  69:simpleserial-bfmax-maskered-8bit.c ****         found_flag |= is_equal;
  70:simpleserial-bfmax-maskered-8bit.c ****     }
  71:simpleserial-bfmax-maskered-8bit.c **** 
  72:simpleserial-bfmax-maskered-8bit.c ****     return max_col;
  73:simpleserial-bfmax-maskered-8bit.c **** }
  74:simpleserial-bfmax-maskered-8bit.c **** 
  75:simpleserial-bfmax-maskered-8bit.c **** /* =========================================================================
  76:simpleserial-bfmax-maskered-8bit.c ****  * FUNZIONE VULNERABILE 2: update_syndrome_and_upcs
  77:simpleserial-bfmax-maskered-8bit.c ****  * Contiene l'indirizzamento di memoria dipendente dal segreto Htr_sparse.
  78:simpleserial-bfmax-maskered-8bit.c ****  * ========================================================================= */
  79:simpleserial-bfmax-maskered-8bit.c **** void __attribute__((noinline)) update_sparse_vulnerable(POS_T col) {
  80:simpleserial-bfmax-maskered-8bit.c ****     uint8_t block = (col >= R_BITS) ? 1 : 0;
  81:simpleserial-bfmax-maskered-8bit.c ****     POS_T col_bit = (block == 1) ? (col - R_BITS) : col;
  82:simpleserial-bfmax-maskered-8bit.c **** 
  83:simpleserial-bfmax-maskered-8bit.c ****     for (uint8_t k = 0; k < D_WEIGHT; k++) {
  84:simpleserial-bfmax-maskered-8bit.c ****         /* Relazione algebrica §5.4 del PDF:
  85:simpleserial-bfmax-maskered-8bit.c ****          * row = (Htr_sparse[block][k] + col_bit) mod R_BITS */
  86:simpleserial-bfmax-maskered-8bit.c ****         POS_T row = Htr_sparse[block][k] + col_bit;
  87:simpleserial-bfmax-maskered-8bit.c ****         if (row >= R_BITS) {
  88:simpleserial-bfmax-maskered-8bit.c ****             row -= R_BITS;
  89:simpleserial-bfmax-maskered-8bit.c ****         }
  90:simpleserial-bfmax-maskered-8bit.c **** 
  91:simpleserial-bfmax-maskered-8bit.c ****         /* Flip del bit di sindrome e aggiornamento contatore UPC.
  92:simpleserial-bfmax-maskered-8bit.c ****          * VULNERABILITA': L'indirizzo toccato dipende da Htr_sparse! */
  93:simpleserial-bfmax-maskered-8bit.c ****         syndrome_bits[row] ^= 1;
  94:simpleserial-bfmax-maskered-8bit.c ****         int8_t delta = syndrome_bits[row] ? +1 : -1;
  95:simpleserial-bfmax-maskered-8bit.c **** 
  96:simpleserial-bfmax-maskered-8bit.c ****         upc[row] = (uint8_t)(upc[row] + delta);
  97:simpleserial-bfmax-maskered-8bit.c ****     }
  98:simpleserial-bfmax-maskered-8bit.c **** }
  99:simpleserial-bfmax-maskered-8bit.c **** 
 100:simpleserial-bfmax-maskered-8bit.c **** /* =========================================================================
 101:simpleserial-bfmax-maskered-8bit.c ****  * COMANDO SIMPLESERIAL 'p': Profiling diretto del Timing Leak di argmax_u8
 102:simpleserial-bfmax-maskered-8bit.c ****  * (§5.2 Fase 1 del PDF: riceve la posizione target p = (p_high << 8) | p_low,
 103:simpleserial-bfmax-maskered-8bit.c ****  * posiziona il massimo esattamente in 'p' e misura la finestra con il trigger)
 104:simpleserial-bfmax-maskered-8bit.c ****  * ========================================================================= */
 105:simpleserial-bfmax-maskered-8bit.c **** uint8_t cmd_profile_argmax(uint8_t* pt, uint8_t len) {
 106:simpleserial-bfmax-maskered-8bit.c ****     if (len < 2) return 0x01;
 107:simpleserial-bfmax-maskered-8bit.c **** 
 108:simpleserial-bfmax-maskered-8bit.c ****     /* Estrae la posizione target 'p' inviata dallo script Python ChipWhisperer */
 109:simpleserial-bfmax-maskered-8bit.c ****     POS_T target_pos = ((uint16_t)pt[0] << 8) | pt[1];
 110:simpleserial-bfmax-maskered-8bit.c ****     if (target_pos >= N_BITS) {
 111:simpleserial-bfmax-maskered-8bit.c ****         target_pos = N_BITS - 1;
 112:simpleserial-bfmax-maskered-8bit.c ****     }
 113:simpleserial-bfmax-maskered-8bit.c **** 
 114:simpleserial-bfmax-maskered-8bit.c ****     /* Prepara l'array UPC con rumore di fondo basso e il picco massimo in target_pos */
 115:simpleserial-bfmax-maskered-8bit.c ****     for (uint16_t i = 0; i < N_BITS; i++) {
 116:simpleserial-bfmax-maskered-8bit.c ****         upc[i] = (uint8_t)((i * 7 + 3) % 10); /* Valori tra 0 e 9 */
 117:simpleserial-bfmax-maskered-8bit.c ****     }
 118:simpleserial-bfmax-maskered-8bit.c ****     upc[target_pos] = 15; /* Massimo unico garantito in posizione target_pos */
 119:simpleserial-bfmax-maskered-8bit.c **** 
 120:simpleserial-bfmax-maskered-8bit.c ****     /* --- INIZIO FINESTRA DI MISURA (Trigger Alto) --- */
 121:simpleserial-bfmax-maskered-8bit.c ****     trigger_high();
 122:simpleserial-bfmax-maskered-8bit.c ****     volatile POS_T found_col = argmax_u8_vulnerable(upc, N_BITS);
 123:simpleserial-bfmax-maskered-8bit.c ****     trigger_low();
 124:simpleserial-bfmax-maskered-8bit.c ****     /* --- FINE FINESTRA DI MISURA (Trigger Basso) --- */
 125:simpleserial-bfmax-maskered-8bit.c **** 
 126:simpleserial-bfmax-maskered-8bit.c ****     /* Restituisce la posizione trovata via SimpleSerial 'r' per verifica */
 127:simpleserial-bfmax-maskered-8bit.c ****     uint8_t resp[2];
 128:simpleserial-bfmax-maskered-8bit.c ****     resp[0] = (uint8_t)(found_col >> 8);
 129:simpleserial-bfmax-maskered-8bit.c ****     resp[1] = (uint8_t)(found_col & 0xFF);
 130:simpleserial-bfmax-maskered-8bit.c ****     simpleserial_put('r', 2, resp);
 131:simpleserial-bfmax-maskered-8bit.c **** 
 132:simpleserial-bfmax-maskered-8bit.c ****     return 0x00;
 133:simpleserial-bfmax-maskered-8bit.c **** }
 134:simpleserial-bfmax-maskered-8bit.c **** 
