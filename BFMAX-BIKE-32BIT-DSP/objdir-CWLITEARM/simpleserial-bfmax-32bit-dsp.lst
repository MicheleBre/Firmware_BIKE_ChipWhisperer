   8:simpleserial-bfmax-32bit-dsp.c **** /* =========================================================================
   9:simpleserial-bfmax-32bit-dsp.c ****  * PARAMETRI CRITTOGRAFICI SCALATI PER SRAM MICROCONTROLLORE (CW-Lite/STM32)
  10:simpleserial-bfmax-32bit-dsp.c ****  * ========================================================================= */
  11:simpleserial-bfmax-32bit-dsp.c **** #define N0 2
  12:simpleserial-bfmax-32bit-dsp.c **** #define R_BITS 512
  13:simpleserial-bfmax-32bit-dsp.c **** #define N_BITS (N0 * R_BITS)
  14:simpleserial-bfmax-32bit-dsp.c **** #define D_WEIGHT 15          /* Peso della riga sparsa segreta (supp(h)) */
  15:simpleserial-bfmax-32bit-dsp.c **** #define ITER_MAX_BFMAX 20    /* Numero massimo di iterazioni del decoder */
  16:simpleserial-bfmax-32bit-dsp.c **** 
  17:simpleserial-bfmax-32bit-dsp.c **** typedef uint16_t POS_T;
  18:simpleserial-bfmax-32bit-dsp.c **** 
  19:simpleserial-bfmax-32bit-dsp.c **** /* Strutture dati: forza l'allineamento a 32-bit per i load/store SIMD */
  20:simpleserial-bfmax-32bit-dsp.c **** __attribute__((aligned(4))) static uint8_t upc[N_BITS];
