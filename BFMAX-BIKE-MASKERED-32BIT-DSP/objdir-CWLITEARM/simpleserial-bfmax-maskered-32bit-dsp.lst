 161:simpleserial-bfmax-maskered-32bit-dsp.c **** uint8_t cmd_profile_argmax(uint8_t* pt, uint8_t len) {
 162:simpleserial-bfmax-maskered-32bit-dsp.c ****     if (len < 2) return 0x01;
 163:simpleserial-bfmax-maskered-32bit-dsp.c **** 
 164:simpleserial-bfmax-maskered-32bit-dsp.c ****     uint16_t target_pos = ((uint16_t)pt[0] << 8) | pt[1];
 165:simpleserial-bfmax-maskered-32bit-dsp.c ****     if (target_pos >= N_BITS) {
 166:simpleserial-bfmax-maskered-32bit-dsp.c ****         target_pos = N_BITS - 1;
 167:simpleserial-bfmax-maskered-32bit-dsp.c ****     }
 168:simpleserial-bfmax-maskered-32bit-dsp.c **** 
 169:simpleserial-bfmax-maskered-32bit-dsp.c ****     for (uint16_t i = 0; i < N_BITS; i++) {
 170:simpleserial-bfmax-maskered-32bit-dsp.c ****         upc[i] = (uint8_t)((i * 7 + 3) % 10);
 171:simpleserial-bfmax-maskered-32bit-dsp.c ****     }
 172:simpleserial-bfmax-maskered-32bit-dsp.c ****     upc[target_pos] = 15;
 173:simpleserial-bfmax-maskered-32bit-dsp.c **** 
 174:simpleserial-bfmax-maskered-32bit-dsp.c ****     volatile uint16_t found_col = argmax_u8_constant_time(upc, N_BITS);
 175:simpleserial-bfmax-maskered-32bit-dsp.c **** 
 176:simpleserial-bfmax-maskered-32bit-dsp.c ****     uint8_t resp[2];
 177:simpleserial-bfmax-maskered-32bit-dsp.c ****     resp[0] = (uint8_t)(found_col >> 8);
 178:simpleserial-bfmax-maskered-32bit-dsp.c ****     resp[1] = (uint8_t)(found_col & 0xFF);
 179:simpleserial-bfmax-maskered-32bit-dsp.c ****     simpleserial_put('r', 2, resp);
 180:simpleserial-bfmax-maskered-32bit-dsp.c **** 
 181:simpleserial-bfmax-maskered-32bit-dsp.c ****     return 0x00;
 182:simpleserial-bfmax-maskered-32bit-dsp.c **** }
