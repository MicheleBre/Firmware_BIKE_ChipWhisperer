 404:.././hal//stm32f3/CMSIS/core/cmsis_gcc.h **** __attribute__((always_inline)) __STATIC_INLINE void __SEV(void)
 405:.././hal//stm32f3/CMSIS/core/cmsis_gcc.h **** {
