 124:simpleserial-bfmax-32bit-dsp.c **** /* =========================================================================
 125:simpleserial-bfmax-32bit-dsp.c ****  * COMANDO SIMPLESERIAL 'p': Profiling diretto del Timing Leak di argmax_u8
 126:simpleserial-bfmax-32bit-dsp.c ****  * ========================================================================= */
 127:simpleserial-bfmax-32bit-dsp.c **** uint8_t cmd_profile_argmax(uint8_t* pt, uint8_t len) {
 128:simpleserial-bfmax-32bit-dsp.c ****     if (len < 2) return 0x01;
 129:simpleserial-bfmax-32bit-dsp.c **** 
 130:simpleserial-bfmax-32bit-dsp.c ****     POS_T target_pos = ((uint16_t)pt[0] << 8) | pt[1];
 131:simpleserial-bfmax-32bit-dsp.c ****     if (target_pos >= N_BITS) {
 132:simpleserial-bfmax-32bit-dsp.c ****         target_pos = N_BITS - 1;
 133:simpleserial-bfmax-32bit-dsp.c ****     }
 134:simpleserial-bfmax-32bit-dsp.c **** 
 135:simpleserial-bfmax-32bit-dsp.c ****     /* Rumore di fondo e posizionamento controllato del massimo */
 136:simpleserial-bfmax-32bit-dsp.c ****     for (uint16_t i = 0; i < N_BITS; i++) {
 137:simpleserial-bfmax-32bit-dsp.c ****         upc[i] = (uint8_t)((i * 7 + 3) % 10);
 138:simpleserial-bfmax-32bit-dsp.c ****     }
 139:simpleserial-bfmax-32bit-dsp.c ****     upc[target_pos] = 15;
 140:simpleserial-bfmax-32bit-dsp.c **** 
 141:simpleserial-bfmax-32bit-dsp.c ****     /* --- INIZIO FINESTRA DI MISURA --- */
 142:simpleserial-bfmax-32bit-dsp.c ****     //trigger_high();
 143:simpleserial-bfmax-32bit-dsp.c ****     volatile POS_T found_col = argmax_u8_vulnerable(upc, N_BITS);
 144:simpleserial-bfmax-32bit-dsp.c ****     //trigger_low();
 145:simpleserial-bfmax-32bit-dsp.c ****     /* --- FINE FINESTRA DI MISURA --- */
 146:simpleserial-bfmax-32bit-dsp.c **** 
 147:simpleserial-bfmax-32bit-dsp.c ****     uint8_t resp[2];
 148:simpleserial-bfmax-32bit-dsp.c ****     resp[0] = (uint8_t)(found_col >> 8);
 149:simpleserial-bfmax-32bit-dsp.c ****     resp[1] = (uint8_t)(found_col & 0xFF);
 150:simpleserial-bfmax-32bit-dsp.c ****     simpleserial_put('r', 2, resp);
 151:simpleserial-bfmax-32bit-dsp.c **** 
 152:simpleserial-bfmax-32bit-dsp.c ****     return 0x00;
 153:simpleserial-bfmax-32bit-dsp.c **** }
