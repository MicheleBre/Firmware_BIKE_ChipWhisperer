 366:.././hal//stm32f3/CMSIS/core/cmsis_gcc.h **** #define __CMSIS_GCC_USE_REG(r) "r" (r)
 367:.././hal//stm32f3/CMSIS/core/cmsis_gcc.h **** #endif
