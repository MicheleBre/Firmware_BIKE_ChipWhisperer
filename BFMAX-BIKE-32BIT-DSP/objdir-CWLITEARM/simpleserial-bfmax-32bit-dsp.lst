 101:simpleserial-bfmax-32bit-dsp.c **** /* =========================================================================
 102:simpleserial-bfmax-32bit-dsp.c ****  * FUNZIONE VULNERABILE 2: update_sparse_vulnerable
 103:simpleserial-bfmax-32bit-dsp.c ****  * Contiene l'indirizzamento di memoria dipendente dal segreto Htr_sparse.
 104:simpleserial-bfmax-32bit-dsp.c ****  * ========================================================================= */
 105:simpleserial-bfmax-32bit-dsp.c **** void __attribute__((noinline)) update_sparse_vulnerable(POS_T col) {
 106:simpleserial-bfmax-32bit-dsp.c ****     uint8_t block = (col >= R_BITS) ? 1 : 0;
 107:simpleserial-bfmax-32bit-dsp.c ****     POS_T col_bit = (block == 1) ? (col - R_BITS) : col;
 108:simpleserial-bfmax-32bit-dsp.c **** 
 109:simpleserial-bfmax-32bit-dsp.c ****     for (uint8_t k = 0; k < D_WEIGHT; k++) {
 110:simpleserial-bfmax-32bit-dsp.c ****         POS_T row = Htr_sparse[block][k] + col_bit;
 111:simpleserial-bfmax-32bit-dsp.c ****         if (row >= R_BITS) {
 112:simpleserial-bfmax-32bit-dsp.c ****             row -= R_BITS;
 113:simpleserial-bfmax-32bit-dsp.c ****         }
 114:simpleserial-bfmax-32bit-dsp.c **** 
 115:simpleserial-bfmax-32bit-dsp.c ****         syndrome_bits[row] ^= 1;
 116:simpleserial-bfmax-32bit-dsp.c ****         int8_t delta = syndrome_bits[row] ? +1 : -1;
 117:simpleserial-bfmax-32bit-dsp.c **** 
 118:simpleserial-bfmax-32bit-dsp.c ****         /* VULNERABILITA' ADDRESS POWER LEAK:
 119:simpleserial-bfmax-32bit-dsp.c ****          * L'indirizzo upc[row] toccato in memoria dipende da Htr_sparse. */
 120:simpleserial-bfmax-32bit-dsp.c ****         upc[row] = (uint8_t)(upc[row] + delta);
 121:simpleserial-bfmax-32bit-dsp.c ****     }
 122:simpleserial-bfmax-32bit-dsp.c **** }
