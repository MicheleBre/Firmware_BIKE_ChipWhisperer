 947:.././hal//stm32f3/stm32f3_hal_lowlevel.c ****     }
 948:.././hal//stm32f3/stm32f3_hal_lowlevel.c ****   }
 949:.././hal//stm32f3/stm32f3_hal_lowlevel.c ****   /* Check if the Receiver is enabled */
