   7:simpleserial-bfmax-8bit.c **** /* =========================================================================
   8:simpleserial-bfmax-8bit.c ****  * PARAMETRI CRITTOGRAFICI SCALATI PER SRAM MICROCONTROLLORE (CW-Lite)
   9:simpleserial-bfmax-8bit.c ****  * Adatta R_BITS in base alla RAM disponibile (es. 512 per XMEGA, 4096 per STM32)
  10:simpleserial-bfmax-8bit.c ****  * ========================================================================= */
  11:simpleserial-bfmax-8bit.c **** #define N0 2
  12:simpleserial-bfmax-8bit.c **** #define R_BITS 512
  13:simpleserial-bfmax-8bit.c **** #define N_BITS (N0 * R_BITS)
  14:simpleserial-bfmax-8bit.c **** #define D_WEIGHT 15         /* Peso della riga sparsa segreta (supp(h)) */
  15:simpleserial-bfmax-8bit.c **** #define ITER_MAX_BFMAX 20    /* Numero massimo di iterazioni del decoder */
  16:simpleserial-bfmax-8bit.c **** 
  17:simpleserial-bfmax-8bit.c **** typedef uint16_t POS_T;
  18:simpleserial-bfmax-8bit.c **** 
  19:simpleserial-bfmax-8bit.c **** /* Strutture dati del decoder e della chiave segreta (stile LEDA/BIKE KEM-CPA) */
  20:simpleserial-bfmax-8bit.c **** static uint8_t upc[N_BITS];
  21:simpleserial-bfmax-8bit.c **** static uint8_t syndrome_bits[R_BITS];
  22:simpleserial-bfmax-8bit.c **** static POS_T Htr_sparse[N0][D_WEIGHT];
  23:simpleserial-bfmax-8bit.c **** 
  24:simpleserial-bfmax-8bit.c **** /* =========================================================================
  25:simpleserial-bfmax-8bit.c ****  * FUNZIONE VULNERABILE 1: argmax_u8 (Versione Scalare di decode_bfmax_avx2.old.c)
  26:simpleserial-bfmax-8bit.c ****  * Contiene l'early-exit nel secondo ciclo che genera il Timing Leak lineare.
  27:simpleserial-bfmax-8bit.c ****  * ========================================================================= */
  28:simpleserial-bfmax-8bit.c **** POS_T __attribute__((noinline)) argmax_u8_vulnerable(const uint8_t *arr, uint16_t len) {
  29:simpleserial-bfmax-8bit.c ****     uint8_t max_val = 0;
  30:simpleserial-bfmax-8bit.c **** 
  31:simpleserial-bfmax-8bit.c ****     /* Passo 1: Ricerca del valore massimo assoluto (tempo costante su tutta la lunghezza) */
  32:simpleserial-bfmax-8bit.c ****     for (uint16_t i = 0; i < len; i++) {
  33:simpleserial-bfmax-8bit.c ****         if (arr[i] > max_val) {
  34:simpleserial-bfmax-8bit.c ****             max_val = arr[i];
  35:simpleserial-bfmax-8bit.c ****         }
  36:simpleserial-bfmax-8bit.c ****     }
  37:simpleserial-bfmax-8bit.c **** 
  38:simpleserial-bfmax-8bit.c ****     /* Passo 2: Ricerca della prima posizione 'col' corrispondente a max_val.
  39:simpleserial-bfmax-8bit.c ****      * VULNERABILITA': Il 'return i' interrompe il ciclo anticipatamente!
  40:simpleserial-bfmax-8bit.c ****      * Il tempo di esecuzione è strettamente proporzionale all'indice 'i' (col). */
  41:simpleserial-bfmax-8bit.c ****     for (uint16_t i = 0; i < len; i++) {
  42:simpleserial-bfmax-8bit.c ****         if (arr[i] == max_val) {
  43:simpleserial-bfmax-8bit.c ****             return (POS_T)i; /* <-- EARLY EXIT (TIMING LEAK) */
  44:simpleserial-bfmax-8bit.c ****         }
  45:simpleserial-bfmax-8bit.c ****     }
  46:simpleserial-bfmax-8bit.c **** 
  47:simpleserial-bfmax-8bit.c ****     return 0;
  48:simpleserial-bfmax-8bit.c **** }
  49:simpleserial-bfmax-8bit.c **** 
  50:simpleserial-bfmax-8bit.c **** /* =========================================================================
  51:simpleserial-bfmax-8bit.c ****  * FUNZIONE VULNERABILE 2: update_syndrome_and_upcs
  52:simpleserial-bfmax-8bit.c ****  * Contiene l'indirizzamento di memoria dipendente dal segreto Htr_sparse.
  53:simpleserial-bfmax-8bit.c ****  * ========================================================================= */
  54:simpleserial-bfmax-8bit.c **** void __attribute__((noinline)) update_sparse_vulnerable(POS_T col) {
  55:simpleserial-bfmax-8bit.c ****     uint8_t block = (col >= R_BITS) ? 1 : 0;
  56:simpleserial-bfmax-8bit.c ****     POS_T col_bit = (block == 1) ? (col - R_BITS) : col;
  57:simpleserial-bfmax-8bit.c **** 
  58:simpleserial-bfmax-8bit.c ****     for (uint8_t k = 0; k < D_WEIGHT; k++) {
  59:simpleserial-bfmax-8bit.c ****         /* Relazione algebrica §5.4 del PDF:
  60:simpleserial-bfmax-8bit.c ****          * row = (Htr_sparse[block][k] + col_bit) mod R_BITS */
  61:simpleserial-bfmax-8bit.c ****         POS_T row = Htr_sparse[block][k] + col_bit;
  62:simpleserial-bfmax-8bit.c ****         if (row >= R_BITS) {
  63:simpleserial-bfmax-8bit.c ****             row -= R_BITS;
  64:simpleserial-bfmax-8bit.c ****         }
  65:simpleserial-bfmax-8bit.c **** 
  66:simpleserial-bfmax-8bit.c ****         /* Flip del bit di sindrome e aggiornamento contatore UPC.
  67:simpleserial-bfmax-8bit.c ****          * VULNERABILITA': L'indirizzo toccato dipende da Htr_sparse! */
  68:simpleserial-bfmax-8bit.c ****         syndrome_bits[row] ^= 1;
  69:simpleserial-bfmax-8bit.c ****         int8_t delta = syndrome_bits[row] ? +1 : -1;
  70:simpleserial-bfmax-8bit.c **** 
  71:simpleserial-bfmax-8bit.c ****         upc[row] = (uint8_t)(upc[row] + delta);
  72:simpleserial-bfmax-8bit.c ****     }
  73:simpleserial-bfmax-8bit.c **** }
  74:simpleserial-bfmax-8bit.c **** 
  75:simpleserial-bfmax-8bit.c **** /* =========================================================================
  76:simpleserial-bfmax-8bit.c ****  * COMANDO SIMPLESERIAL 'p': Profiling diretto del Timing Leak di argmax_u8
  77:simpleserial-bfmax-8bit.c ****  * (§5.2 Fase 1 del PDF: riceve la posizione target p = (p_high << 8) | p_low,
  78:simpleserial-bfmax-8bit.c ****  * posiziona il massimo esattamente in 'p' e misura la finestra con il trigger)
  79:simpleserial-bfmax-8bit.c ****  * ========================================================================= */
  80:simpleserial-bfmax-8bit.c **** uint8_t cmd_profile_argmax(uint8_t* pt, uint8_t len) {
  81:simpleserial-bfmax-8bit.c ****     if (len < 2) return 0x01;
  82:simpleserial-bfmax-8bit.c **** 
  83:simpleserial-bfmax-8bit.c ****     /* Estrae la posizione target 'p' inviata dallo script Python ChipWhisperer */
  84:simpleserial-bfmax-8bit.c ****     POS_T target_pos = ((uint16_t)pt[0] << 8) | pt[1];
  85:simpleserial-bfmax-8bit.c ****     if (target_pos >= N_BITS) {
  86:simpleserial-bfmax-8bit.c ****         target_pos = N_BITS - 1;
  87:simpleserial-bfmax-8bit.c ****     }
  88:simpleserial-bfmax-8bit.c **** 
  89:simpleserial-bfmax-8bit.c ****     /* Prepara l'array UPC con rumore di fondo basso e il picco massimo in target_pos */
  90:simpleserial-bfmax-8bit.c ****     for (uint16_t i = 0; i < N_BITS; i++) {
  91:simpleserial-bfmax-8bit.c ****         upc[i] = (uint8_t)((i * 7 + 3) % 10); /* Valori tra 0 e 9 */
  92:simpleserial-bfmax-8bit.c ****     }
  93:simpleserial-bfmax-8bit.c ****     upc[target_pos] = 15; /* Massimo unico garantito in posizione target_pos */
  94:simpleserial-bfmax-8bit.c **** 
  95:simpleserial-bfmax-8bit.c ****     /* --- INIZIO FINESTRA DI MISURA (Trigger Alto) --- */
  96:simpleserial-bfmax-8bit.c ****     trigger_high();
  97:simpleserial-bfmax-8bit.c ****     volatile POS_T found_col = argmax_u8_vulnerable(upc, N_BITS);
  98:simpleserial-bfmax-8bit.c ****     trigger_low();
  99:simpleserial-bfmax-8bit.c ****     /* --- FINE FINESTRA DI MISURA (Trigger Basso) --- */
 100:simpleserial-bfmax-8bit.c **** 
 101:simpleserial-bfmax-8bit.c ****     /* Restituisce la posizione trovata via SimpleSerial 'r' per verifica */
 102:simpleserial-bfmax-8bit.c ****     uint8_t resp[2];
 103:simpleserial-bfmax-8bit.c ****     resp[0] = (uint8_t)(found_col >> 8);
 104:simpleserial-bfmax-8bit.c ****     resp[1] = (uint8_t)(found_col & 0xFF);
 105:simpleserial-bfmax-8bit.c ****     simpleserial_put('r', 2, resp);
 106:simpleserial-bfmax-8bit.c **** 
 107:simpleserial-bfmax-8bit.c ****     return 0x00;
 108:simpleserial-bfmax-8bit.c **** }
